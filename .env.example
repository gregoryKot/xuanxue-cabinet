# Порт, на котором Nest поднимает API и раздаёт статику web/dist. Railway задаёт свой PORT сам.
PORT=3000

# Строка подключения MongoDB Atlas (кластер M0). Локально — свой Atlas-проект или локальный mongod.
MONGODB_URI=mongodb://localhost:27017/xuanxue-cabinet

# Токен бота из BotFather. Нужен для вебхука бота и для проверки подписи
# виджета входа через Telegram (/auth/telegram). При компрометации — revoke
# в BotFather и завести новый. Обязателен в production.
BOT_TOKEN=

# Telegram ID первого админа: при первом входе через виджет получает роли
# admin и teacher. После первого входа переменную можно убрать — дальше роли
# назначаются на экране «Люди» (Сводка → Люди).
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# Секрет подписи сессионных JWT сайта. Ротация инвалидирует все активные сессии.
JWT_SECRET=

# AES-256-GCM ключ шифрования свободного текста и токенов каналов — 32 байта в hex (64 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Ключи предыдущей ротации ENCRYPTION_KEY, через запятую — используются только на чтение (fallback).
# Не ротировать ENCRYPTION_KEY без re-encryption миграции, см. CLAUDE.md.
ENCRYPTION_KEY_OLD=

# Публичный URL сервиса (для ссылок в рассылках, вебхука бота, email-входа).
# В production — https://xuanxue.su (ADR-0009, RUNBOOK §2.1). Без завершающего слэша.
PUBLIC_URL=http://localhost:3000

# Секрет вебхука Telegram-бота (заголовок x-telegram-bot-api-secret-token,
# SECURITY §2). Без него вебхук выключен (503). В production — при регистрации
# вебхука (RUNBOOK §5). Обязателен в production. Сгенерировать:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Уровень логов pino: fatal / error / warn / info / debug / trace.
LOG_LEVEL=info

# Планировщик занятий (тик раз в минуту, docs/PLAN.md §6). true/false —
# выключать только в тестах (api/test/e2e-support/create-app.ts); в проде и в
# Docker-смоке CI остаётся true.
SCHEDULER_ENABLED=true

# SHA коммита, из которого собран образ — /api/health отдаёт короткий вариант
# (RUNBOOK §2 п.1). Railway ставит её сама при сборке, локально не нужна —
# исключена из общей сверки .env.example (scripts/check-env-example.mjs
# пропускает всё, что начинается с RAILWAY_, как переменные платформы).
RAILWAY_GIT_COMMIT_SHA=

# Адрес «кнопки жизни» (healthchecks.io и совместимые, dead man's switch,
# ADR-0112): после каждого здорового тика планировщик шлёт на него пустой GET.
# Не пришёл вовремя — сервис сам поднимает тревогу в Telegram учителю через
# свой grace period. Пусто — пинга нет, как в тестах и локально.
HEARTBEAT_PING_URL=

# Ключ Resend (resend.com) для письма входа по одноразовой ссылке (ADR-0029).
# Без него и без MAIL_FROM email-вход выключен (POST /auth/email/request
# отвечает «не подключён») — не обязателен в production, Telegram остаётся.
# Как подключить: docs/RUNBOOK.md §5.
RESEND_API_KEY=

# Отправитель письма входа: адрес или «Имя <адрес@домен>» — домен должен быть
# подтверждён в Resend (SPF/DKIM/DMARC, RUNBOOK §5), иначе письма уходят в спам.
MAIL_FROM=

# Cloudflare R2 — хранилище файлов материалов (ADR-0057). Четыре переменные
# задаются все вместе или ни одной: без них загрузка файлов выключена, поля на
# экране нет, кабинет поднимается как прежде (локальная разработка, CI и
# Docker-смок в хранилище не ходят). Где взять: Cloudflare → R2 → бакет, затем
# «Manage R2 API Tokens» → токен с правами Object Read & Write на этот бакет.
# Ротация — docs/RUNBOOK.md §6.4.
# Идентификатор аккаунта Cloudflare (он же поддомен эндпоинта <id>.r2.cloudflarestorage.com).
R2_ACCOUNT_ID=

# Access Key ID токена R2.
R2_ACCESS_KEY_ID=

# Secret Access Key токена R2. Показывается один раз при создании токена.
R2_SECRET_ACCESS_KEY=

# Имя бакета, в котором лежат файлы материалов.
R2_BUCKET=

# Push-уведомления в браузере (ADR-0092). Три переменные задаются все вместе
# или ни одной: без них push выключен — POST /me/push-subscriptions отвечает
# честным отказом, GET /push/public-key отдаёт { publicKey: null }, весь
# остальной кабинет работает как прежде (риск сначала на владельце, CLAUDE.md
# «Рискованная фича — за флагом»). Сгенерировать пару:
# node scripts/generate-vapid-keys.mjs
# Как включить впервые и ротация — docs/RUNBOOK.md §6.5.
# Публичный ключ — несжатая точка P-256 в base64url (87 символов), уходит в
# pushManager.subscribe() на клиенте; сам по себе не секрет.
VAPID_PUBLIC_KEY=

# Приватный ключ — 32 байта в base64url (43 символа), подписывает заголовок
# Authorization запроса к push-сервису (RFC 8292). Секрет — тот же уровень,
# что BOT_TOKEN.
VAPID_PRIVATE_KEY=

# Контакт школы для push-сервиса на случай проблем с доставкой — mailto:
# или https://, формат из RFC 8292.
VAPID_SUBJECT=
