# Порт, на котором Nest поднимает API и раздаёт статику web/dist. Railway задаёт свой PORT сам.
PORT=3000

# Строка подключения MongoDB Atlas (кластер M0). Локально — свой Atlas-проект или локальный mongod.
MONGODB_URI=mongodb://localhost:27017/xuanxue-cabinet

# Токен бота из BotFather. Нужен для вебхука бота и для проверки подписи
# виджета входа через Telegram (/auth/telegram). При компрометации — revoke
# в BotFather и завести новый.
BOT_TOKEN=

# Telegram ID первого админа: при первом входе через виджет получает роли
# admin и teacher. После первого входа переменную можно убрать — дальше роли
# назначаются в интерфейсе.
BOOTSTRAP_ADMIN_TELEGRAM_ID=

# Секрет подписи сессионных JWT сайта. Ротация инвалидирует все активные сессии.
JWT_SECRET=

# AES-256-GCM ключ шифрования свободного текста и токенов каналов — 32 байта в hex (64 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Ключи предыдущей ротации ENCRYPTION_KEY, через запятую — используются только на чтение (fallback).
# Не ротировать ENCRYPTION_KEY без re-encryption миграции, см. CLAUDE.md.
ENCRYPTION_KEY_OLD=

# Публичный URL сервиса (для ссылок в рассылках, вебхука бота, email-входа).
# В production — https://xuanxue.su (ADR-0009, RUNBOOK §2.1). Без завершающего слэша.
PUBLIC_URL=http://localhost:3000

# Секрет вебхука Telegram-бота (заголовок x-telegram-bot-api-secret-token,
# SECURITY §2). Без него вебхук выключен (503). В production — при регистрации
# вебхука (RUNBOOK §5). Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=

# Уровень логов pino: fatal / error / warn / info / debug / trace.
LOG_LEVEL=info

# Планировщик занятий (тик раз в минуту, docs/PLAN.md §6). true/false —
# выключать только в тестах (api/test/e2e-support/create-app.ts); в проде и в
# Docker-смоке CI остаётся true.
SCHEDULER_ENABLED=true

# SHA коммита, из которого собран образ — /api/health отдаёт короткий вариант
# (RUNBOOK §2 п.1). Railway ставит её сама при сборке, локально не нужна —
# исключена из общей сверки .env.example (scripts/check-env-example.mjs
# пропускает всё, что начинается с RAILWAY_, как переменные платформы).
RAILWAY_GIT_COMMIT_SHA=
