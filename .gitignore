# Без завершающего слэша: он ловит только каталоги, а `node_modules` бывает и
# симлинком (общие зависимости между git-worktree). Такой симлинк попадал в
# `git add -A` и ронял `npm ci` в CI с ENOTDIR (аудит 2026-09-12, L).
node_modules
dist/
coverage/
.jest-cache/
.env
.env.*
!.env.example
.DS_Store
# Личные настройки Claude Code (settings.local.json) не коммитим, а скилл
# /collaborate — часть репозитория (ADR-0169): исключение возвращает его в git.
.claude/*
!.claude/skills/

# Реальные ссылки Zoom, пароли и токены каналов живут только локально
api/seed/*.local.json

# Локальные бэкапы Mongo (scripts/backup-mongo.sh) — даже зашифрованные, в
# репозиторий не кладём (CLAUDE.md, «Данные (MongoDB)»)
backups/
