# Порт, на котором Nest поднимает API и раздаёт статику web/dist. Railway задаёт свой PORT сам.
PORT=3000

# Строка подключения MongoDB Atlas (кластер M0). Локально — свой Atlas-проект или локальный mongod.
MONGODB_URI=mongodb://localhost:27017/xuanxue-cabinet

# Токен бота из BotFather. При компрометации — revoke в BotFather и завести новый.
BOT_TOKEN=

# Секрет подписи сессионных JWT сайта. Ротация инвалидирует все активные сессии.
JWT_SECRET=

# AES-256-GCM ключ шифрования свободного текста и токенов каналов — 32 байта в hex (64 символа).
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# Ключи предыдущей ротации ENCRYPTION_KEY, через запятую — используются только на чтение (fallback).
# Не ротировать ENCRYPTION_KEY без re-encryption миграции, см. CLAUDE.md.
ENCRYPTION_KEY_OLD=

# Публичный URL сервиса (для ссылок в рассылках, вебхука бота, email-входа).
# В production — https://xuanxue.su (ADR-0009, RUNBOOK §2.1). Без завершающего слэша.
PUBLIC_URL=http://localhost:3000

# Уровень логов pino: fatal / error / warn / info / debug / trace.
LOG_LEVEL=info
